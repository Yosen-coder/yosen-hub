local function checkShadowBan()
local isBanned = false
pcall(function()
local stats = LocalPlayer:FindFirstChild("leaderstats")
if stats then
local banFlag = stats:FindFirstChild("ShadowBanned") or stats:FindFirstChild("Banned")
if banFlag then isBanned = banFlag.Value end
end
end)
return isBanned
end

