local function getMissionFile()
if writefile and readfile and isfile then
if not isfolder("frizzks_hub") then makefolder("frizzks_hub") end
local path = "frizzks_hub/missions.txt"
if isfile(path) then
local num = tonumber(readfile(path))
if num then return num end
end
end
return 0
end

local function saveMissionFile(num)
if writefile then
if not isfolder("frizzks_hub") then makefolder("frizzks_hub") end
writefile("frizzks_hub/missions.txt", tostring(num))
end
end

